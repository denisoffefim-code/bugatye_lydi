APP_NAME=SkyCast
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://skycast:skycast@localhost:5432/skycast
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_PREFIX=skycast
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=skycast
KAFKA_CLIENT_ID=skycast-outbox-worker
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SSL_CAFILE=
KAFKA_SSL_CERTFILE=
KAFKA_SSL_KEYFILE=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_PREVIOUS_RUNS_BASE_URL=https://previous-runs-api.open-meteo.com
OPEN_METEO_MODEL=best_match
NOAA_IGRA_STATION_LIST_URL=https://www.ncei.noaa.gov/pub/data/igra/igra2-station-list.txt
REQUEST_TIMEOUT_SECONDS=45
MAX_PARALLEL_REQUESTS=4
RATE_LIMIT_PER_SECOND=3
STARTUP_MIGRATE=true
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_SECONDS=2
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_MAX_RETRY_DELAY_SECONDS=300
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_SPOOL_ENABLED=true
OUTBOX_SPOOL_DIR=.skycast-outbox-spool
LOG_LEVEL=INFO
LOG_JSON=true
AUTH_SESSION_TTL_HOURS=168
AUTH_PASSWORD_HASH_ITERATIONS=390000
AUTH_CACHE_ENABLED=true
AUTH_CACHE_TTL_SECONDS=300
AUTH_LAST_USED_THROTTLE_SECONDS=60
TRANSPORT_TOPICS=forecast.accepted,telemetry.accepted
TRANSPORT_RECENT_EVENTS_LIMIT=100
TRANSPORT_EVENT_TTL_SECONDS=604800
TRANSPORT_OBSERVER_CLIENT_ID=skycast-transport-observer
TRANSPORT_OBSERVER_CONSUMER_GROUP=skycast-transport-observer
TRANSPORT_OBSERVER_POLL_SECONDS=2
TRANSPORT_OBSERVER_BATCH_SIZE=100
